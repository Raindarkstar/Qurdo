{
  "expo": {
    "name": "Quanto",
    "slug": "quanto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quanto-icon.png",
    "scheme": "quanto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/quanto-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.rain.quanto",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/quanto-icon.png",
        "backgroundImage": "./assets/images/quanto-icon.png",
        "monochromeImage": "./assets/images/quanto-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/quanto-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2501abd3-303b-4f22-a869-e3837b086ad5"
      }
    },
    "owner": "raindark"
  }
}
